FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt requirements-test.txt requirements-dev.txt ./

RUN pip install --no-cache-dir -r requirements-dev.txt

# Source is mounted via volume in docker-compose.yml (enables hot reload)
EXPOSE 5000 5678

ENV DJANGO_SETTINGS_MODULE=app.settings.development

CMD ["python", "-m", "debugpy", "--listen", "0.0.0.0:5678", \
     "-m", "uvicorn", "asgi:application", "--host", "0.0.0.0", "--port", "5000", "--reload"]
